# Proxmox Codex Bridge Environment Configuration

# Server Ports & Host
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# AI Provider API Keys & Tokens
# Replace with your actual KMITL GPU Token or OpenAI/Anthropic keys
KMITL_TOKEN=your_kmitl_gpu_token_here
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Security & API Protection
# Optional: Set a Bearer Token to protect the API from unauthorized local LAN requests
# BRIDGE_API_KEY=your-secret-api-token-here

# Directories
WORKSPACES_DIR=/opt/agent-bridge/workspaces
